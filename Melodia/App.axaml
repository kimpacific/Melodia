<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Melodia.ViewModels"
             xmlns:v="using:Melodia.Views"
             x:Class="Melodia.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Melodia/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="Accent" Color="#E8440C" />

      <!-- Slider look: orange fill, dark track, small round thumb -->
      <SolidColorBrush x:Key="SliderTrackFill" Color="#4A4A4A" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#555555" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#555555" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E8440C" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF5A22" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF5A22" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#E8440C" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF5A22" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF5A22" />
      <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
      <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
      <x:Double x:Key="SliderVerticalThumbWidth">14</x:Double>
      <x:Double x:Key="SliderVerticalThumbHeight">14</x:Double>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Every TrackViewModel shown in an ItemsControl uses the standard song row (the album panel overrides it) -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TrackViewModel">
      <v:TrackRowView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Melodia/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
