<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Melodia.Views.ArtistsView">
  <!-- DataContext: ArtistsViewModel -->
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <StackPanel Grid.Row="0" Margin="0,6,0,0">
      <TextBlock Text="Artists" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="Search for an artist, then open them to play their songs" FontSize="12" Foreground="#8E8E8E" Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,16,0,14">
      <Grid ColumnDefinitions="Auto,*" Width="420">
        <Border Grid.ColumnSpan="2" Background="#262626" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="18" />
        <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="Uniform" Fill="#9A9A9A"
              VerticalAlignment="Center" Margin="14,0,0,0" />
        <TextBox Grid.Column="1" Classes="plain" Margin="6,0,10,0" Text="{Binding Query, Mode=TwoWay}"
                 Watermark="Artist name, e.g. Rema">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </Grid>
      <Button Classes="flat pill accent" Content="Search" Command="{Binding SearchCommand}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,10">
      <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                 Foreground="#8E8E8E" FontSize="12.5" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Artists}" Margin="0,4,12,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="flat" Width="164" Margin="0,0,18,18" Command="{Binding OpenCommand}">
              <StackPanel Spacing="8">
                <Border Width="164" Height="164" CornerRadius="82" ClipToBounds="True" Background="#2A2A2A">
                  <Panel>
                    <Path Data="{StaticResource IconPerson}" Width="64" Height="64" Stretch="Uniform" Fill="#4A4A4A" />
                    <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                <TextBlock Text="{Binding FollowersText}" FontSize="11" Foreground="#8E8E8E" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
