<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Melodia.Views.TrackRowView">
  <Button Classes="flat row" Classes.current="{Binding IsCurrent}" Classes.missing="{Binding IsMissing}"
          Command="{Binding PlayCommand}">
    <Grid ColumnDefinitions="44,46,*,*,56,36,Auto">
      <TextBlock Text="{Binding Index}" FontSize="15" Opacity="0.85" VerticalAlignment="Center" />
      <Border Grid.Column="1" Width="30" Height="30" CornerRadius="4" ClipToBounds="True"
              Background="#3A3A3A" HorizontalAlignment="Left">
        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
      </Border>
      <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      <TextBlock Grid.Column="3" Text="{Binding Artist}" FontSize="12" Opacity="0.8" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
      <Button Grid.Column="5" Classes="flat icon" Width="28" Height="28" HorizontalAlignment="Right"
              Command="{Binding ToggleFavoriteCommand}">
        <Path Classes="heart" Classes.on="{Binding IsFavorite}" Data="{StaticResource IconHeart}"
              Width="15" Height="15" Stretch="Uniform" />
      </Button>
      <Button Grid.Column="6" Classes="flat icon remove" Width="28" Height="28" Margin="4,0,0,0"
              IsVisible="{Binding CanRemove}" Command="{Binding RemoveCommand}"
              ToolTip.Tip="Remove from this playlist">
        <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform"
              Fill="{Binding $parent[Button].Foreground}" />
      </Button>
    </Grid>
  </Button>
</UserControl>
