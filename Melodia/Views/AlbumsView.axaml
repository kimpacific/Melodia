<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Melodia.Views.AlbumsView">
  <!-- DataContext: AlbumsViewModel -->
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <StackPanel Grid.Row="0" Margin="0,6,0,0">
      <TextBlock Text="Albums" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="Trending albums this week" FontSize="12" Foreground="#8E8E8E" Margin="0,4,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
      <Button Classes="flat pill" Content="Refresh" Command="{Binding RefreshCommand}" />
    </StackPanel>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
               Foreground="#8E8E8E" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Albums}" Margin="0,0,12,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="flat" Width="164" Margin="0,0,18,18" Command="{Binding OpenCommand}">
              <StackPanel Spacing="8">
                <Border Width="164" Height="164" CornerRadius="10" ClipToBounds="True" Background="#2A2A2A">
                  <Panel>
                    <Path Data="{StaticResource IconDisc}" Width="64" Height="64" Stretch="Uniform" Fill="#4A4A4A" />
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="164" />
                <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="#B9B9B9" TextTrimming="CharacterEllipsis" MaxWidth="164" />
                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#8E8E8E" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
