<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Melodia.Views.AlbumPanelView">
  <!-- DataContext: AlbumPanelViewModel -->
  <UserControl.Resources>
    <DataTemplate x:Key="AlbumRow">
      <Button Classes="flat albumrow" Classes.current="{Binding IsCurrent}" Command="{Binding PlayCommand}">
        <Border BorderBrush="#363636" BorderThickness="0,0,0,1" Height="43">
          <Grid ColumnDefinitions="34,*,Auto">
            <TextBlock Text="{Binding Index}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Text="Albums" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="flat icon" Width="28" Height="28" Command="{Binding PreviousAlbumCommand}">
        <Path Data="{StaticResource IconChevronLeft}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" />
      </Button>
      <Button Grid.Column="2" Classes="flat icon" Width="28" Height="28" Command="{Binding NextAlbumCommand}">
        <Path Data="{StaticResource IconChevronRight}" Width="18" Height="18" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="#262626" CornerRadius="18" ClipToBounds="True">
      <Panel>
        <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                   Foreground="#8E8E8E" FontSize="12.5" TextWrapping="Wrap" Margin="22,150,22,0"
                   VerticalAlignment="Top" />
        <Panel IsVisible="{Binding HasAlbum}">
          <Grid RowDefinitions="Auto,*" DataContext="{Binding CurrentAlbum}">
            <Border Background="#3A3A3A" Padding="20" CornerRadius="0,0,18,18">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="88" Height="88" CornerRadius="6" ClipToBounds="True" Background="#505050">
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="6">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                             MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#A5A5A5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Info}" FontSize="10" Foreground="#8E8E8E" />
                </StackPanel>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Margin="0,8,0,10" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource AlbumRow}" />
            </ScrollViewer>
          </Grid>
        </Panel>
      </Panel>
    </Border>
  </Grid>
</UserControl>
